enum wisdom_WebPlayer {
  "wisdom_WebPlayer::Human",
  "wisdom_WebPlayer::ChessEngine"
};

enum wisdom_WebColor {
  "wisdom_WebColor::NoColor",
  "wisdom_WebColor::White",
  "wisdom_WebColor::Black",
};

enum wisdom_WebPiece {
  "wisdom_WebPiece::NoPiece",
  "wisdom_WebPiece::Pawn",
  "wisdom_WebPiece::Knight",
  "wisdom_WebPiece::Bishop",
  "wisdom_WebPiece::Rook",
  "wisdom_WebPiece::Queen",
  "wisdom_WebPiece::King"
};

enum wisdom_WebGameStatus {
    "wisdom_WebGameStatus::Playing",
    "wisdom_WebGameStatus::Checkmate",
    "wisdom_WebGameStatus::Stalemate",
    "wisdom_WebGameStatus::ThreefoldRepetitionReached",
    "wisdom_WebGameStatus::ThreefoldRepetitionAccepted",
    "wisdom_WebGameStatus::FivefoldRepetitionDraw",
    "wisdom_WebGameStatus::FiftyMovesWithoutProgressReached",
    "wisdom_WebGameStatus::FiftyMovesWithoutProgressAccepted",
    "wisdom_WebGameStatus::SeventyFiveMovesWithoutProgressDraw",
    "wisdom_WebGameStatus::InsufficientMaterialDraw",
};

[Prefix="wisdom::"]
interface WebColoredPiece {
    void WebColoredPiece (long id, wisdom_WebColor color, wisdom_WebPiece piece, long row, long col);
    attribute long id;
    attribute wisdom_WebColor color;
    attribute wisdom_WebPiece piece;
    attribute long row;
    attribute long col;
};

[Prefix="wisdom::"]
interface WebColoredPieceList {
    void WebColoredPieceList();
    [Value] attribute WebColoredPiece[] pieces;
    [Value] WebColoredPiece pieceAt (long index);
    attribute long length;
};

[Prefix="wisdom::"]
interface GameSettings {
    void GameSettings ();
    void GameSettings (wisdom_WebPlayer whitePlayer, wisdom_WebPlayer blackPlayer, long thinkingTime, long searchDepth);
    attribute wisdom_WebPlayer whitePlayer;
    attribute wisdom_WebPlayer blackPlayer;
    attribute long thinkingTime;
    attribute long searchDepth;
    attribute boolean debugLogging;
};

enum wisdom_WebDrawStatus {
    "wisdom_WebDrawStatus::NotReached",
    "wisdom_WebDrawStatus::Proposed",
    "wisdom_WebDrawStatus::Accepted",
    "wisdom_WebDrawStatus::Declined"
};

enum wisdom_WebDrawByRepetitionType {
    "wisdom_WebDrawByRepetitionType::ThreefoldRepetition",
    "wisdom_WebDrawByRepetitionType::FiftyMovesWithoutProgress"
};

[Prefix="wisdom::"]
interface WebGame {
    [Ref] WebColoredPieceList getPieceList();

    // Squares are in algebraic notation, such as "e2".
    boolean needsPawnPromotion (DOMString src, DOMString dst);

    // Returns the packed move for GameModel.notifyHumanMove(), or -1 if the
    // move is not legal.
    long makeHumanMove (DOMString src, DOMString dst, wisdom_WebPiece pieceType);

    void makeComputerMove (DOMString moveText);

    void setSettings([Const, Ref] GameSettings newSettings);

    boolean getInCheck();
    [Const] DOMString getMoveStatus();
    [Const] DOMString getGameOverStatus();
    attribute long moveNumber;
    long getGameId();

    wisdom_WebColor getCurrentTurn();
    wisdom_WebGameStatus getGameStatus();
    wisdom_WebPlayer getPlayerOfColor(wisdom_WebColor color);

    void setComputerDrawStatus(wisdom_WebDrawByRepetitionType type, wisdom_WebColor who, boolean accepted);
    void setHumanDrawStatus(wisdom_WebDrawByRepetitionType type, wisdom_WebColor who, boolean accepted);
};

[Prefix="wisdom::"]
interface GameModel {
    void GameModel();

    void sendPause();
    void sendUnpause();

    // Notify the chess engine about a human move.
    void notifyHumanMove (long packedMove);
    void notifyComputerMove();

    WebGame startNewGame();

    GameSettings getCurrentGameSettings();
    void setCurrentGameSettings (GameSettings newSettings);

    wisdom_WebColor getFirstHumanPlayerColor();
    wisdom_WebColor getSecondHumanPlayerColor();

    // The ranges the settings controls offer.
    long getMinThinkingTime();
    long getMaxThinkingTime();
    long getMinSearchDepth();
    long getMaxSearchDepth();
};

